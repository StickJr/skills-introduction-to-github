{
  "name": "folio",
  "version": "1.0.0",
  "description": "A minimalist personal learning library: turn any link or topic into a readable article.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
